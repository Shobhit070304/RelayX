# ==========================================
# Common Gitignore for RelayX Engine & Client
# ==========================================

# 1. Dependencies
node_modules/
client/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Build & Next.js Output
dist/
build/
.next/
client/.next/
out/
client/out/
coverage/

# 3. Environment & Secret Files (Ignore all local envs, allow examples)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env*.local
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
!.env.example
!client/.env.example

# 4. Debug & Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts