{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "server/dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}